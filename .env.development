# Development Environment Configuration
# This file contains development-specific settings

# Application Settings
NODE_ENV=development
APP_NAME=Sprint3-Dev
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=localhost
APP_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sprint3_dev
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=dev_jwt_secret_key_not_for_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=4
SESSION_SECRET=dev_session_secret

# API Keys & External Services (Test/Development keys)
API_KEY=dev_api_key
STRIPE_PUBLIC_KEY=pk_test_development_key
STRIPE_SECRET_KEY=sk_test_development_key
SENDGRID_API_KEY=dev_sendgrid_key
AWS_ACCESS_KEY_ID=dev_aws_access_key
AWS_SECRET_ACCESS_KEY=dev_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sprint3-dev-bucket

# OAuth Configuration (Development)
GOOGLE_CLIENT_ID=dev_google_client_id
GOOGLE_CLIENT_SECRET=dev_google_client_secret
GITHUB_CLIENT_ID=dev_github_client_id
GITHUB_CLIENT_SECRET=dev_github_client_secret

# Email Configuration (Development - using Mailtrap or similar)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dev_user
SMTP_PASSWORD=dev_password
SMTP_FROM=dev@sprint3.local

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/dev.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API_RATE_LIMIT=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx,txt,csv,zip

# Cache Settings
CACHE_TTL=60
CACHE_ENABLED=true

# Monitoring & Analytics
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
GOOGLE_ANALYTICS_ID=

# Development Tools
DEBUG=true
MOCK_EXTERNAL_APIS=true
