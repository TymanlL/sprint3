# Database connection string
# PostgreSQL: postgresql://user:password@host:port/database
# MySQL: mysql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# LLM Provider (gigachat, openai)
LLM_PROVIDER=gigachat

# GigaChat credentials (Authorization Data from https://developers.sber.ru/studio/)
# Get your credentials at: https://developers.sber.ru/portal/products/gigachat
GIGACHAT_CREDENTIALS=your-base64-credentials-here

# GigaChat scope (GIGACHAT_API_PERS for personal, GIGACHAT_API_CORP for corporate)
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# GigaChat model (GigaChat, GigaChat-Plus, GigaChat-Pro)
GIGACHAT_MODEL=GigaChat

# OpenAI API Key (optional, if using OpenAI provider)
OPENAI_API_KEY=sk-your-api-key-here
