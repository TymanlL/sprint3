# Production Environment Configuration
# This file contains production-specific settings
# CRITICAL: All values marked CHANGE_ME must be updated with actual production values

# Application Settings
NODE_ENV=production
APP_NAME=Sprint3
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=https://sprint3.com

# Database Configuration
DB_HOST=CHANGE_ME_production_db_host
DB_PORT=5432
DB_NAME=sprint3_production
DB_USER=CHANGE_ME_production_db_user
DB_PASSWORD=CHANGE_ME_production_db_password_use_strong_password
DB_SSL=true
DB_POOL_MIN=10
DB_POOL_MAX=50

# Redis Configuration
REDIS_HOST=CHANGE_ME_production_redis_host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_production_redis_password
REDIS_DB=0

# Authentication & Security
# CRITICAL: Generate strong secrets using: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_production_jwt_secret_minimum_64_characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_production_refresh_token_secret_minimum_64_characters
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=CHANGE_ME_production_session_secret_minimum_64_characters

# API Keys & External Services (Production keys)
API_KEY=CHANGE_ME_production_api_key
STRIPE_PUBLIC_KEY=CHANGE_ME_pk_live_production_key
STRIPE_SECRET_KEY=CHANGE_ME_sk_live_production_key
SENDGRID_API_KEY=CHANGE_ME_production_sendgrid_key
AWS_ACCESS_KEY_ID=CHANGE_ME_production_aws_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_production_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sprint3-production-bucket

# OAuth Configuration (Production)
GOOGLE_CLIENT_ID=CHANGE_ME_production_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_production_google_client_secret
GITHUB_CLIENT_ID=CHANGE_ME_production_github_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_production_github_client_secret

# Email Configuration (Production)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_production_sendgrid_password
SMTP_FROM=noreply@sprint3.com

# Logging
LOG_LEVEL=error
LOG_FILE=logs/production.log
LOG_MAX_SIZE=100m
LOG_MAX_FILES=30

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=true
ENABLE_API_RATE_LIMIT=true

# CORS Configuration
CORS_ORIGIN=https://sprint3.com,https://www.sprint3.com
CORS_CREDENTIALS=true

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Cache Settings
CACHE_TTL=3600
CACHE_ENABLED=true

# Monitoring & Analytics
SENTRY_DSN=CHANGE_ME_production_sentry_dsn
NEW_RELIC_LICENSE_KEY=CHANGE_ME_production_newrelic_key
GOOGLE_ANALYTICS_ID=CHANGE_ME_production_ga_id

# Development Tools
DEBUG=false
MOCK_EXTERNAL_APIS=false
