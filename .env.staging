# Staging Environment Configuration
# This file contains staging-specific settings for pre-production testing

# Application Settings
NODE_ENV=staging
APP_NAME=Sprint3-Staging
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=https://staging.sprint3.com

# Database Configuration
DB_HOST=staging-db.sprint3.com
DB_PORT=5432
DB_NAME=sprint3_staging
DB_USER=staging_user
DB_PASSWORD=CHANGE_ME_staging_password
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

# Redis Configuration
REDIS_HOST=staging-redis.sprint3.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0

# Authentication & Security
JWT_SECRET=CHANGE_ME_staging_jwt_secret_use_strong_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=CHANGE_ME_staging_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
SESSION_SECRET=CHANGE_ME_staging_session_secret

# API Keys & External Services (Test/Staging keys)
API_KEY=CHANGE_ME_staging_api_key
STRIPE_PUBLIC_KEY=pk_test_staging_key
STRIPE_SECRET_KEY=sk_test_staging_key
SENDGRID_API_KEY=CHANGE_ME_staging_sendgrid_key
AWS_ACCESS_KEY_ID=CHANGE_ME_staging_aws_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_staging_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sprint3-staging-bucket

# OAuth Configuration (Staging)
GOOGLE_CLIENT_ID=CHANGE_ME_staging_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_staging_google_client_secret
GITHUB_CLIENT_ID=CHANGE_ME_staging_github_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_staging_github_client_secret

# Email Configuration (Staging)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_staging_sendgrid_password
SMTP_FROM=staging@sprint3.com

# Logging
LOG_LEVEL=info
LOG_FILE=logs/staging.log
LOG_MAX_SIZE=50m
LOG_MAX_FILES=14

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=true
ENABLE_API_RATE_LIMIT=true

# CORS Configuration
CORS_ORIGIN=https://staging.sprint3.com
CORS_CREDENTIALS=true

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# Cache Settings
CACHE_TTL=1800
CACHE_ENABLED=true

# Monitoring & Analytics
SENTRY_DSN=CHANGE_ME_staging_sentry_dsn
NEW_RELIC_LICENSE_KEY=CHANGE_ME_staging_newrelic_key
GOOGLE_ANALYTICS_ID=UA-STAGING-ID

# Development Tools
DEBUG=false
MOCK_EXTERNAL_APIS=false
